{
  "ConnectionStrings": {
    "ProductConnection": "Server=localhost;Database=BookStore.Products;User Id=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;TrustServerCertificate=True;",
    "AuthenticationConnection": "Server=localhost;Database=BookStore.Authentication;User Id=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;TrustServerCertificate=True;",
    "RedisConnection": "localhost:6379,password=YOUR_REDIS_PASSWORD,abortConnect=false,connectTimeout=5000,syncTimeout=5000"
  },
  "Jwt": {
    "Issuer": "localhost",
    "Audience": "bookstore-microservices",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "AbsoluteRefreshTokenExpirationDays": 30,
    "KeyRotationDays": 30,
    "KeyGracePeriodDays": 2,
    "CleanTokenDurationHours": 24
  },
  "Authentication": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID"
    },
    "Microsoft": {
      "ClientId": "YOUR_MICROSOFT_CLIENT_ID"
    }
  },
  "Redis": {
    "InstancePrefix": "bookstore:"
  }
}
